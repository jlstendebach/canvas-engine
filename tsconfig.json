{
    "compilerOptions": {
        // MARK: - Target Environments
        "target": "ES2022", // Modern JS for canvas features
        "module": "NodeNext", // Handles modern browser ESM module loading smoothly
        "moduleResolution": "NodeNext",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ], // Native browser dictionaries only (Canvas, DOM, Events)

        // MARK: - Input/Output File Mapping
        "rootDir": "./src", // Where your source TS files live
        "outDir": "./dist", // Where the clean JavaScript gets output

        // MARK: - Autocomplete Generation for Your Users
        "declaration": true, // Automatically generates .d.ts files
        "sourceMap": true, // Let's you debug the original TS directly in your browser

        // MARK: - Gradual Migration Controls
        "allowJs": true, // Lets you move files in step-by-step
        "checkJs": false, // Won't throw compiler errors on legacy JS files
        "strict": false // Keeps things relaxed until the migration is done
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}