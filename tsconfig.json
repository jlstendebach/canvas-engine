{
    "compilerOptions": {
        // MARK: - Target Environments
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "types": [],

        // MARK: - Input/Output File Mapping
        "rootDir": "./src",
        "outDir": "./dist",

        // MARK: - Autocomplete Generation for Your Users
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        // MARK: - Type Safety
        "strict": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true,

        // MARK: - Gradual Migration Controls
        "allowJs": true,
        "checkJs": false
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}